{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/MicroMilo/awesome-claude-code-codex-papers/data/schema.json",
  "title": "Claude Code and Codex Paper Catalog",
  "type": "object",
  "additionalProperties": false,
  "required": ["catalog_version", "reviewed_at", "papers"],
  "properties": {
    "catalog_version": {
      "const": 3
    },
    "reviewed_at": {
      "type": "string",
      "format": "date"
    },
    "papers": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/paper"
      }
    }
  },
  "$defs": {
    "product": {
      "type": "object",
      "additionalProperties": false,
      "required": ["product", "role", "model", "version"],
      "properties": {
        "product": {
          "enum": ["claude-code", "codex-cli"]
        },
        "role": {
          "enum": ["baseline", "evaluated", "host"]
        },
        "model": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "reasoning_mode": {
          "type": "string",
          "minLength": 1
        },
        "temperature": {
          "type": "string",
          "minLength": 1
        },
        "max_output_tokens": {
          "type": "string",
          "minLength": 1
        },
        "budget": {
          "type": "string",
          "minLength": 1
        },
        "runs": {
          "type": "string",
          "minLength": 1
        },
        "tool_permissions": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "paper": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "title",
        "authors",
        "year",
        "year_tag",
        "conference",
        "conference_tag",
        "venue",
        "domains",
        "publication_status",
        "classification",
        "system",
        "paper_url",
        "source_type",
        "audit_status",
        "artifact_status",
        "products",
        "task",
        "experiment",
        "method",
        "evidence"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "title": {
          "type": "string",
          "minLength": 5
        },
        "authors": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 2
          }
        },
        "year": {
          "const": 2026
        },
        "year_tag": {
          "const": 2026
        },
        "conference": {
          "enum": [
            "AAAI",
            "ASE",
            "FSE",
            "ICLR",
            "ICML",
            "ICSE",
            "ISSTA",
            "NeurIPS",
            "IJCAI",
            "KDD",
            "PLDI",
            "POPL",
            "OOPSLA"
          ]
        },
        "conference_tag": {
          "enum": [
            "AAAI",
            "ASE",
            "FSE",
            "ICLR",
            "ICML",
            "ICSE",
            "ISSTA",
            "NeurIPS",
            "IJCAI",
            "KDD",
            "PLDI",
            "POPL",
            "OOPSLA"
          ]
        },
        "venue": {
          "type": "string",
          "minLength": 2
        },
        "domains": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "software-engineering",
              "security",
              "systems-performance",
              "machine-learning",
              "scientific-computing",
              "formal-methods",
              "web-ui",
              "documents"
            ]
          }
        },
        "publication_status": {
          "enum": [
            "main",
            "conference",
            "workshop",
            "tool-demo",
            "dataset-benchmark"
          ]
        },
        "classification": {
          "enum": ["direct", "related", "evaluation"]
        },
        "system": {
          "type": "string",
          "minLength": 2
        },
        "paper_url": {
          "type": "string",
          "format": "uri",
          "pattern": "^https://"
        },
        "source_type": {
          "enum": [
            "official-conference",
            "official-proceedings",
            "openreview-conference",
            "official-publisher"
          ]
        },
        "audit_status": {
          "const": "included"
        },
        "artifact_url": {
          "type": "string",
          "format": "uri",
          "pattern": "^https://"
        },
        "artifact_status": {
          "enum": ["official", "community", "not-found"]
        },
        "doi": {
          "type": "string",
          "pattern": "^10\\.[0-9]{4,9}/[-._;()/:A-Za-z0-9]+$"
        },
        "published_at": {
          "type": "string",
          "format": "date"
        },
        "products": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/product"
          }
        },
        "task": {
          "type": "object",
          "additionalProperties": false,
          "required": ["summary", "benchmark"],
          "properties": {
            "summary": {
              "type": "string",
              "minLength": 3
            },
            "benchmark": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "experiment": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "reasoning_mode",
            "temperature",
            "max_output_tokens",
            "time_budget",
            "turn_budget",
            "token_budget",
            "api_budget",
            "runs",
            "tool_permissions",
            "baseline_config"
          ],
          "properties": {
            "reasoning_mode": { "type": "string", "minLength": 1 },
            "temperature": { "type": "string", "minLength": 1 },
            "max_output_tokens": { "type": "string", "minLength": 1 },
            "time_budget": { "type": "string", "minLength": 1 },
            "turn_budget": { "type": "string", "minLength": 1 },
            "token_budget": { "type": "string", "minLength": 1 },
            "api_budget": { "type": "string", "minLength": 1 },
            "runs": { "type": "string", "minLength": 1 },
            "tool_permissions": { "type": "string", "minLength": 1 },
            "baseline_config": { "type": "string", "minLength": 1 }
          }
        },
        "method": {
          "type": "object",
          "additionalProperties": false,
          "required": ["summary", "tags"],
          "properties": {
            "summary": {
              "type": "string",
              "minLength": 3
            },
            "tags": {
              "type": "array",
              "uniqueItems": true,
              "items": {
                "enum": [
                  "structured-state",
                  "repository-graph",
                  "retrieval",
                  "context-reduction",
                  "verifier-loop",
                  "static-analysis",
                  "test-feedback",
                  "performance-feedback",
                  "multi-agent",
                  "dynamic-specialization",
                  "dependency-aware-planning",
                  "parallelism",
                  "memory",
                  "harness-evolution",
                  "observability",
                  "repository-instructions",
                  "deterministic-search",
                  "visual-review",
                  "coordination",
                  "adversarial-testing",
                  "benchmark-design"
                ]
              }
            }
          }
        },
        "evidence": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "result",
            "same_model",
            "same_budget",
            "strength",
            "claim_type",
            "comparison_scope",
            "source_location",
            "caveats"
          ],
          "properties": {
            "result": {
              "type": "string",
              "minLength": 3
            },
            "same_model": {
              "enum": ["yes", "no", "unknown"]
            },
            "same_budget": {
              "enum": ["yes", "no", "unknown"]
            },
            "strength": {
              "enum": ["high", "medium", "contextual"]
            },
            "claim_type": {
              "enum": ["quality", "efficiency", "mixed", "diagnostic"]
            },
            "comparison_scope": {
              "enum": [
                "product-level",
                "component-level",
                "configuration-ablation",
                "benchmark-only"
              ]
            },
            "source_location": {
              "type": "string",
              "minLength": 3
            },
            "caveats": {
              "type": "string",
              "minLength": 3
            }
          }
        },
        "notes": {
          "type": "string"
        }
      }
    }
  }
}
