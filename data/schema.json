{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/MicroMilo/awesome-claude-code-codex-papers/data/schema.json",
  "title": "Claude Code and Codex Paper Catalog",
  "type": "object",
  "additionalProperties": false,
  "required": ["catalog_version", "reviewed_at", "papers"],
  "properties": {
    "catalog_version": {
      "const": 1
    },
    "reviewed_at": {
      "type": "string",
      "format": "date"
    },
    "papers": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/paper"
      }
    }
  },
  "$defs": {
    "product": {
      "type": "object",
      "additionalProperties": false,
      "required": ["product", "role", "model", "version"],
      "properties": {
        "product": {
          "enum": ["claude-code", "codex-cli", "openai-codex-model"]
        },
        "role": {
          "enum": ["baseline", "evaluated", "host", "historical-baseline"]
        },
        "model": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "paper": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "title",
        "year",
        "venue",
        "publication_status",
        "classification",
        "paper_url",
        "products",
        "task",
        "method",
        "evidence"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "title": {
          "type": "string",
          "minLength": 5
        },
        "year": {
          "type": "integer",
          "minimum": 2020,
          "maximum": 2100
        },
        "venue": {
          "type": "string",
          "minLength": 2
        },
        "publication_status": {
          "enum": [
            "main",
            "conference",
            "workshop",
            "tool-demo",
            "dataset-benchmark",
            "journal",
            "preprint"
          ]
        },
        "classification": {
          "enum": ["direct", "related", "evaluation", "historical"]
        },
        "paper_url": {
          "type": "string",
          "format": "uri",
          "pattern": "^https://"
        },
        "artifact_url": {
          "type": "string",
          "format": "uri",
          "pattern": "^https://"
        },
        "products": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/product"
          }
        },
        "task": {
          "type": "object",
          "additionalProperties": false,
          "required": ["summary", "benchmark"],
          "properties": {
            "summary": {
              "type": "string",
              "minLength": 3
            },
            "benchmark": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "method": {
          "type": "object",
          "additionalProperties": false,
          "required": ["summary", "tags"],
          "properties": {
            "summary": {
              "type": "string",
              "minLength": 3
            },
            "tags": {
              "type": "array",
              "uniqueItems": true,
              "items": {
                "enum": [
                  "structured-state",
                  "repository-graph",
                  "retrieval",
                  "context-reduction",
                  "verifier-loop",
                  "static-analysis",
                  "test-feedback",
                  "performance-feedback",
                  "multi-agent",
                  "dynamic-specialization",
                  "dependency-aware-planning",
                  "parallelism",
                  "memory",
                  "harness-evolution",
                  "observability",
                  "repository-instructions",
                  "deterministic-search",
                  "visual-review"
                ]
              }
            }
          }
        },
        "evidence": {
          "type": "object",
          "additionalProperties": false,
          "required": ["result", "same_model", "same_budget", "strength", "caveats"],
          "properties": {
            "result": {
              "type": "string",
              "minLength": 3
            },
            "same_model": {
              "enum": ["yes", "no", "unknown"]
            },
            "same_budget": {
              "enum": ["yes", "no", "unknown"]
            },
            "strength": {
              "enum": ["high", "medium", "contextual"]
            },
            "caveats": {
              "type": "string",
              "minLength": 3
            }
          }
        },
        "notes": {
          "type": "string"
        }
      }
    }
  }
}
